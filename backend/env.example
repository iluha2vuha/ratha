# Copy to backend/.env. Server-side only: never put this key in the frontend.
# The Google Cloud project needs billing and Places API (New) enabled.
GOOGLE_PLACES_API_KEY=

# Geograph imagery is server-side. Without a working key/provider response, the
# UI deliberately uses and labels a mock estimate.
GEOGRAPH_API_KEY=

# Optional: install requirements-ai.txt and enable local CLIP terrain analysis.
WILD_CAMP_VISION_PROVIDER=mock
